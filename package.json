{
  "name": "flow",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "sh tools/check.sh",
    "preview": "vite preview",
    "app": "vite build && (env -u ELECTRON_RUN_AS_NODE electron . 2>&1 | grep -v -e sandbox_extension_issue_file -e \"Window move completed without beginning\"; true)",
    "dmg": "vite build && electron-builder --mac dmg --arm64",
    "train-ai": "node tools/ai/train.mjs",
    "build-due-ai": "node tools/due-ai/make.cjs",
    "win": "vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.1"
  },
  "description": "Flow: personal finance tracker",
  "author": "Rassam",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.rassam.flow",
    "productName": "Flow",
    "asar": false,
    "electronLanguages": [
      "en"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!**/node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!**/node_modules/node-llama-cpp/templates/**",
      "!**/node_modules/**/*.map"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.gguf"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Flow",
      "format": "UDBZ",
      "background": "build/background.png",
      "iconSize": 96,
      "iconTextSize": 13,
      "window": {
        "width": 660,
        "height": 405
      },
      "contents": [
        {
          "x": 165,
          "y": 240,
          "type": "file"
        },
        {
          "x": 495,
          "y": 240,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Flow-Setup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Flow",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "afterPack": "build/after-pack.cjs"
  }
}
