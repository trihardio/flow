{
  "name": "flow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && env -u ELECTRON_RUN_AS_NODE electron .",
    "dmg": "vite build && electron-builder --mac dmg --arm64",
    "train-ai": "node tools/ai/train.mjs"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.1"
  },
  "description": "Flow: personal finance tracker",
  "author": "Rassam",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.rassam.flow",
    "productName": "Flow",
    "asar": false,
    "electronLanguages": ["en"],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!**/node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!**/node_modules/node-llama-cpp/templates/**",
      "!**/node_modules/**/*.map"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.gguf"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Flow",
      "format": "UDBZ"
    }
  }
}
